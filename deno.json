{
  "name": "@erickmerchant/icons",
  "version": "0.3.0",
  "license": "MIT",
  "tasks": {
    "dev": "deno run -A --watch-hmr flint.ts --port=4000",
    "build": "deno run -A flint.ts --build",
    "stage": {
      "command": "deno serve -A --port=4000 --parallel dist/serve.ts",
      "dependencies": ["build"]
    }
  },
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@flint/framework": "jsr:@flint/framework@^0.40.1",
    "@handcraft/lib": "jsr:@handcraft/lib@^4.6.1",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "unstable": ["bundle"],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable",
      "es2025"
    ]
  }
}
